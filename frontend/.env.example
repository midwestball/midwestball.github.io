# Supabase project URL (public). Frontend reads JSON from the public Storage bucket.
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Optional: full Storage prefix override (defaults to NEXT_PUBLIC_SUPABASE_URL + /storage/v1/object/public/knowball-public)
# VIZ_STORAGE_BASE_URL=
